rules_version = '2';
service cloud.firestore { match /databases/{database}/documents { function isAdmin() { return request.auth != null && request.auth.token.admin == true; } match /posts/{post} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); } match /projects/{project} { allow read: if resource.data.published == true || isAdmin(); allow write: if isAdmin(); } } }
